{
  "name": "bizidea-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ideas-index": "node scripts/build-ideas-index.mjs",
    "check:agents": "node scripts/check-agent-frontmatter.mjs",
    "check:triage": "node scripts/check-triage.mjs",
    "check:ideas-index": "node scripts/build-ideas-index.mjs --strict --check",
    "check:duplicates": "node scripts/check-near-duplicates.mjs",
    "check:content-quality": "node scripts/check-content-quality.mjs",
    "check:ideas": "npm --prefix website run check:ideas",
    "check:zh-translations": "node scripts/check-zh-translations.mjs ideas",
    "check:types": "npm --prefix website run typecheck",
    "measure:quality": "node scripts/measure-quality.mjs",
    "test": "vitest run",
    "validate:all": "node scripts/validate-all.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
